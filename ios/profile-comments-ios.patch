+/// Adds the Profile Comments tab right after Posts and Gifts on regular user profiles.
+private func peerInfoInsertProfileComments(context: AccountContext, peerView: PeerView, availablePanes: inout [PeerInfoPaneKey]?) {
+    guard availablePanes != nil, let user = peerView.peers[peerView.peerId] as? TelegramUser, user.botInfo == nil, !user.flags.contains(.isSupport) else {
+        return
+    }
+    if availablePanes?.contains(.comments) == true {
+        return
+    }
+    guard ProfileCommentsStore.shared(accountPeerId: context.account.peerId).isTabVisible(ownerId: peerView.peerId) else {
+        return
+    }
+    let index = (availablePanes ?? []).prefix(while: { $0 == .stories || $0 == .gifts }).count
+    availablePanes?.insert(.comments, at: index)
+}
