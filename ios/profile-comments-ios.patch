+
+    // MARK: - Actions
+
+    @objc private func filterPressed(_ sender: UIButton) {
+        let id = sender.accessibilityIdentifier ?? ""
+        let filter: String? = id.isEmpty ? nil : id
+        if filter == self.tagFilter {
+            return
+        }
+        self.tagFilter = filter
